{
  "name": "unaib-computer-accessories-pos",
  "version": "1.0.0",
  "description": "Desktop POS, Inventory, Warranty & Financial Management System for Unaib Computer Accessories",
  "main": "electron/main.cjs",
  "scripts": {
    "start:server": "node backend/src/server.js",
    "dev:server": "node backend/src/server.js",
    "dev:react": "vite --config frontend/vite.config.js",
    "dev:electron": "wait-on tcp:5173 tcp:5001 && electron .",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:web": "concurrently -k \"npm run dev:server\" \"npm run dev:react\"",
    "build:react": "vite build --config frontend/vite.config.js",
    "build": "npm run build:react",
    "start": "node backend/src/server.js",
    "start:electron": "cross-env NODE_ENV=production electron .",
    "test:api": "node backend/test-endpoints.js",
    "test": "npm run test:api",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.unaib.accessories.pos",
    "productName": "Unaib Computer Accessories POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "pos",
    "electron",
    "react",
    "computer-accessories",
    "inventory",
    "warranty-tracking",
    "thermal-receipt"
  ],
  "author": "Unaib Computer Accessories",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.475.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
